# Environment for `docker compose up`. Copy to .env.docker and fill in the secrets:
#   cp .env.docker.example .env.docker
#   php artisan key:generate --show   -> paste into APP_KEY

APP_NAME=Wynnsea
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Frontend origins allowed by CORS (comma separated)
FRONTEND_URLS=http://localhost:3000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Laravel -> MySQL (service "db")
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=change-me

# MySQL container (must match the DB_* values above)
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# New contact messages are emailed to ADMIN_EMAIL. "log" only writes them to the log.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME=Wynnsea

# Single admin account, created by the seeder on first start
ADMIN_NAME=Wayan
ADMIN_EMAIL=wayaandeva123@gmail.com
ADMIN_PASSWORD=
